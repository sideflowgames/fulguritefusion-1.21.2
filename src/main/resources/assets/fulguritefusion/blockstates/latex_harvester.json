{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "formed": "false"
      },
      "apply": {
        "model": "fulguritefusion:block/latex_harvester"
      }
    },
    {
      "when": {
        "facing": "east",
        "formed": "false"
      },
      "apply": {
        "model": "fulguritefusion:block/latex_harvester",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "formed": "false"
      },
      "apply": {
        "model": "fulguritefusion:block/latex_harvester",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "formed": "false"
      },
      "apply": {
        "model": "fulguritefusion:block/latex_harvester",
        "y": 270
      }
    },
    {
      "when": {
        "formed": "true"
      },
      "apply": {
        "model": "fulguritefusion:block/machine_part_formed"
      }
    }
  ]
}